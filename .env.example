# Server-only Firebase Admin values. Never prefix these with VITE_.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# Comma-separated Firebase Authentication UIDs approved for the admin panel.
ADMIN_ALLOWED_UIDS=your-approved-firebase-auth-uid

# Optional for local emulator use only. Do not set this in Vercel.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
